# 复制为 .env 后填入真实地址与密钥（.env 不入库）：cp .env.example .env
# 变量名规则：<前缀>_BASE_URL / <前缀>_API_KEY / <前缀>_MAX_TOKENS，
# 前缀由 src/graph2skill/llm.py 里的 MODEL_PROFILES 按模型名登记。
# 环境变量优先于 .env，可临时覆盖：QWEN38_BASE_URL=... graph2skill steps ...

# qwen3.6-27b
QWEN36_BASE_URL=http://<host>:<port>/v1
QWEN36_API_KEY=

# qwen3.8-27b（默认模型）
QWEN38_BASE_URL=http://<host>:<port>/v1
QWEN38_API_KEY=

# 输出预算，留空用 MODEL_PROFILES 里的默认值（16384）
# QWEN36_MAX_TOKENS=16384
# QWEN38_MAX_TOKENS=16384

# 走 Claude API 通道时（--provider anthropic）用这个；也可用 ant auth login
# ANTHROPIC_API_KEY=
